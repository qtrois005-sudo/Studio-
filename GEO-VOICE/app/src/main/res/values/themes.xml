<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.GeoVoice" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Thème du splash natif (Android 12+ SplashScreen API), avec le vrai logo GEO VOICE -->
    <style name="Theme.GeoVoice.Splash" parent="Theme.GeoVoice">
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/geovoice_background_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="s">@color/ic_launcher_background</item>
        <item name="postSplashScreenTheme" tools:targetApi="s">@style/Theme.GeoVoice</item>
    </style>
</resources>
